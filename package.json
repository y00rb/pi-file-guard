{
  "name": "pi-file-guard",
  "version": "0.1.0",
  "description": "Sensitive-file guard extension for the pi coding agent",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "file-guard.example.yaml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/y00rb/pi-file-guard"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --bun ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "minimatch": "10.2.6",
    "shell-quote": "1.12.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/bun": "1.3.14",
    "@types/shell-quote": "1.7.5",
    "typescript": "5.9.3"
  }
}
